# Port untuk service ini (harus sama dengan AGENT_API_URL di autograder-app/.env)
PORT=4000

# URL callback ke Next.js, tempat hasil grading dikirim balik
CALLBACK_URL=""

# Harus sama persis dengan AGENT_CALLBACK_SECRET di autograder-app/.env
AGENT_CALLBACK_SECRET=""
AGENT_SECRET=""

# API key Google AI Studio (Gemini) — ambil dari https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Kredensial Google OAuth untuk akses Google Drive (download file jawaban mahasiswa)
# Harus sama dengan yang dipakai di autograder-app/.env
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
