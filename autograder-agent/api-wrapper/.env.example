# Port untuk service ini (harus sama dengan AGENT_API_URL di autograder-app/.env)
PORT=4000

# URL callback ke Next.js, tempat hasil grading dikirim balik
CALLBACK_URL=""

# Opsional: URL khusus untuk live trace (progres langkah grading).
# Default: diturunkan dari CALLBACK_URL (/grade-callback -> /api/webhook/trace).
# TRACE_URL=""

# Harus sama persis dengan AGENT_CALLBACK_SECRET di autograder-app/.env
AGENT_CALLBACK_SECRET=""
AGENT_SECRET=""

# ==========================================
# LLM PROVIDERS (failover otomatis berurutan)
# ==========================================
# Urutan prioritas dari atas ke bawah. Provider pertama yang punya key & sukses
# dipanggil yang dipakai. Contoh: gemini,openrouter
LLM_PROVIDERS="gemini"

# --- Gemini (AI Studio) ---
# Bisa lebih dari satu key untuk rotasi otomatis saat kena 429 rate limit.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
# GEMINI_API_KEY_4=""
GEMINI_MODEL="gemini-3.6-flash"

# --- OpenRouter (satu key, akses banyak model) ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat"

# --- Groq (limit longgar & cepat, open model) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ==========================================
# Kredensial Google OAuth untuk akses Google Drive (download file jawaban mahasiswa)
# ==========================================
# Harus sama dengan yang dipakai di autograder-app/.env
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
