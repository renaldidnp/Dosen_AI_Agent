# --- Koneksi database (MySQL) ---
DATABASE_URL="mysql://user:password@127.0.0.1:3306/autograder"

# --- URL publik aplikasi ini ---
# DIPAKAI untuk membangun link di email (mis. tombol "Lihat Rincian Nilai").
# Kalau kosong, link email jadi "http://undefined/..." yang rusak.
# Untuk lokal: http://localhost:3000 ; untuk diakses dari luar via ngrok: https://xxx.ngrok-free.app
APP_URL="http://localhost:3000"

# --- Secret untuk webhook dari agent ---
# Sama persis dengan AGENT_CALLBACK_SECRET di autograder-agent/api-wrapper/.env
AGENT_CALLBACK_SECRET=""

# --- Secret internal (webhook lain / validasi) ---
WEBHOOK_SECRET=""

# --- URL dan secret agent (service AI grading) ---
# URL endpoint agent; secret harus sama dengan AGENT_SECRET di .env agent
AGENT_API_URL="http://localhost:4000"
AGENT_SECRET=""

# --- Kredensial Google OAuth untuk akses Google Drive (upload/download file jawaban) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# --- JWT untuk sesi login dosen ---
JWT_SECRET=""

# --- (Opsional) alias URL agent lama jika ada kode yang masih memakainya ---
# AUTOGRADER_AGENT_URL=""

# --- Email (Resend) untuk mengirim hasil ke mahasiswa ---
RESEND_API_KEY=""
# RESEND_FROM_EMAIL="SwaKoreksiIn <onboarding@resend.dev>"