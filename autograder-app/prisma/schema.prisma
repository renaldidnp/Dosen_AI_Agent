generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}

model Dosen {
  id        String   @id @default(cuid())
  nama      String
  email     String   @unique
  password  String
  soal      Soal[]
  createdAt DateTime @default(now())
}

model Mahasiswa {
  id        String   @id @default(cuid())
  nama      String
  nim       String
  email     String
  kelasId   String
  kelas     Kelas    @relation(fields: [kelasId], references: [id])

  createdAt DateTime @default(now())

  @@unique([nim, kelasId])
}

model Kelas {
  id            String   @id @default(cuid())
  nama          String   // contoh: "TI-A", "SI-Malam"
  angkatan      String   // contoh: "2022"
  driveFolderId String?  // cache: ID folder Drive untuk kelas ini (di dalam folder angkatan)
  googleFormId  String?  // ← baru: ID Google Form khusus kelas ini
  googleFormUrl String?  // ← baru: URL Google Form khusus kelas ini
  mahasiswa     Mahasiswa[]
  soal          Soal[]
  createdAt     DateTime @default(now())
  @@unique([nama, angkatan])
}

model Soal {
  id             String   @id @default(cuid())
  judul          String
  deskripsi      String?  @db.Text
  dosenId        String
  dosen          Dosen    @relation(fields: [dosenId], references: [id])
  kelasId        String?
  kelas          Kelas?   @relation(fields: [kelasId], references: [id])
  mataKuliah     String?
  googleFormId   String?  // ← deprecated, dibiarkan untuk kompatibilitas data lama, tidak dipakai lagi
  googleFormUrl  String?  // ← deprecated, dibiarkan untuk kompatibilitas data lama, tidak dipakai lagi
  driveFolderId  String?
  pdfUrl         String?
  pdfDriveFileId String?
  indikator      Indikator[]
  submission     Submission[]
  createdAt      DateTime @default(now())

  @@unique([judul, kelasId])
}

model Indikator {
  id        String   @id @default(cuid())
  soalId    String
  soal      Soal     @relation(fields: [soalId], references: [id])
  nama      String
  bobot     Float
  rubrik    String   @db.Text          
  skorMax   Float    @default(100)
}

model Submission {
  id              String   @id @default(cuid())
  soalId          String
  soal            Soal     @relation(fields: [soalId], references: [id])

  namaMahasiswa   String
  nim             String
  emailMahasiswa  String

  driveFileId     String   // file_id dari Google Drive
  driveFileUrl    String
  formResponseId  String?  @unique // ID respons dari Google Form, cegah duplikat

  status          String   @default("diterima")
  accessToken     String   @unique @default(cuid())

  hasilKoreksi    HasilKoreksi?

  createdAt       DateTime @default(now())
}

model HasilKoreksi {
  id              String   @id @default(cuid())
  submissionId    String   @unique
  submission      Submission @relation(fields: [submissionId], references: [id])

  skorTotal       Float
  skorPerIndikator Json    // [{ indikatorId, nama, skor, catatan }]
  feedback        String

  emailTerkirim   Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}