# ==========================================
# Template env untuk deploy ke VPS (Docker Compose)
#
# 1. Copy file ini menjadi:
#      autograder-app/.env
#      autograder-agent/api-wrapper/.env
# 2. Isi semua value di bawah dengan nilai yang nyata.
# 3. Jangan pernah commit .env ke git!
# ==========================================

# --- MySQL root password (dipakai docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=ganti_dengan_password_kuat

# ==========================================
# autograder-app/.env
# ==========================================
# DATABASE_URL di container memakai nama service "mysql" sebagai host,
# BUKAN 127.0.0.1 (karena app jalan di dalam Docker network).
DATABASE_URL="mysql://root:ganti_dengan_password_kuat@mysql:3306/autograder"

# URL publik (ganti ke domain kalau sudah punya)
APP_URL="http://IP_VPS_KAMU"

# Secret webhook — HARUS SAMA antara app dan agent
WEBHOOK_SECRET="ganti_random_string_panjang"
AGENT_CALLBACK_SECRET="ganti_random_string_panjang"

# Agent diakses dari app via nama service Docker (canonical — dipakai untuk
# grading DAN AI Assistant/generate-soal)
AGENT_API_URL="http://agent:4000"
AGENT_SECRET="ganti_random_string_panjang"

# Google OAuth (Drive)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# JWT session dosen
JWT_SECRET="ganti_random_string_panjang_beda"

# Resend email
RESEND_API_KEY=""

# Opsional alias URL agent lama (tidak wajib; AGENT_API_URL di atas sudah cukup)
# AUTOGRADER_AGENT_URL=""

# ==========================================
# autograder-agent/api-wrapper/.env
# ==========================================
PORT=4000

# Callback ke app — pakai IP publik VPS
CALLBACK_URL="http://IP_VPS_KAMU/api/webhook/grade-callback"
# TRACE_URL default diturunkan dari CALLBACK_URL. Set manual jika perlu.

# Secret — HARUS SAMA dengan di app
AGENT_CALLBACK_SECRET="ganti_random_string_panjang"
AGENT_SECRET="ganti_random_string_panjang"

# LLM Providers (failover berurutan)
LLM_PROVIDERS="gemini"
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_MODEL="gemini-3.6-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nex-agi/nex-n2.5-mini:free"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Google OAuth (Drive) — sama dengan di app
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""